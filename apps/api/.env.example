# Postgres local (docker compose up -d). Valores de desarrollo: no son credenciales reales.
DB_HOST=localhost
DB_PORT=5432
DB_USER=greenlight
DB_PASSWORD=greenlight
DB_NAME=greenlight
# SSL: se activa solo si el host no es localhost (Neon lo exige). DB_SSL=true|false lo fuerza.
# DB_SSL=false

# Solo para migrar contra Neon: la conexión directa (host SIN "-pooler"), con ?sslmode=require. Opcional.
# DATABASE_URL_DIRECT=

# --- Autenticación (obligatorias: la API no arranca sin ellas) ---
# Firma de los tokens. Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Cuánto dura un token (formato de @nestjs/jwt: 30d, 12h, 3600...)
JWT_EXPIRES_IN=30d
# Código que pide el registro, para que un desconocido que encuentre la URL no pueda crearse una cuenta.
INVITE_CODE=

# Detrás de un proxy (Render): 1 para que el límite de intentos use la IP real de cada persona. Opcional.
# TRUST_PROXY=1
# Intentos por minuto en login y registro (por IP). Por defecto 5. Opcional.
# AUTH_RATE_LIMIT=5

# --- Solo para la migración AddUsers (opcionales para arrancar la API) ---
# Con datos existentes, la migración crea con esto a la dueña de todo lo que ya había.
# OWNER_PASSWORD_HASH sale de: npm run hash-password -w @greenlight/api  (va entre comillas simples en .env: lleva "$")
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD_HASH=
